  "scripts": {
    "bootstrap": "pnpm install",
    "build": "cross-env NODE_ENV=production NODE_OPTIONS=--max-old-space-size=20480 pnpm vite build -l error",
    "build:analyze": "cross-env NODE_OPTIONS=--max-old-space-size=8192 pnpm vite build --mode analyze",
    "build:app-designer": "cross-env NODE_OPTIONS=--max-old-space-size=8192 pnpm vite build --base /app-designer/",
    "build:backend-management": "cross-env NODE_OPTIONS=--max-old-space-size=8192 pnpm vite build --base /backend-management/",
    "build:developer-center": "cross-env NODE_OPTIONS=--max-old-space-size=8192 pnpm vite build --base /developer-center/",
    "build:edhr": "pnpm -r --filter=@gct/mobile  run build:edhr",
    "build:ipad": "pnpm -r --filter=@gct/mobile  run build:ipad",
    "build:mobile": "pnpm -r --filter=@gct/mobile  run build",
    "build:mobile-start": "pnpm -r --filter=@gct/mobile  run build:start",
    "build:no-cache": "pnpm clean:cache && npm run build",
    "build:online-form": "cross-env NODE_OPTIONS=--max-old-space-size=20480 VITE_ONLINE_FORM_HOSTED_ONLY=true VITE_SKIP_BUILD_GZIP=true pnpm vite build --base /online-form/",
    "build:page-designer": "cross-env NODE_OPTIONS=--max-old-space-size=8192 pnpm vite build --base /page-designer/",
    "build:portal": "cross-env NODE_OPTIONS=--max-old-space-size=8192 pnpm vite build --base /portal/",
    "build:print-ssr": "cross-env NODE_OPTIONS=--max-old-space-size=8192 pnpm vite build --base /print-ssr/",
    "build:test": "cross-env NODE_OPTIONS=--max-old-space-size=8192 pnpm vite build --mode test",
    "build:web-render": "cross-env NODE_OPTIONS=--max-old-space-size=8192 pnpm vite build --base /web-render/",
    "commit": "czg",
    "dev": "pnpm vite",
    "dev:edhr": "pnpm -r --filter=@gct/mobile  run dev:edhr",
    "dev:ipad": "pnpm -r --filter=@gct/mobile  run dev:ipad",
    "dev:lab": "cross-env VITE_GLOBAL_HOST=http://paas.lab.gct-paas.com pnpm vite",
    "dev:mobile": "pnpm -r --filter=@gct/mobile  run dev",
    "dev:mobile-start": "pnpm -r --filter=@gct/mobile  run dev:start",
    "dev:online-form": "pnpm vite --host 0.0.0.0 --port 3100 --base /template-designer-runtime/ --clearScreen false",
    "docs": "npm run gen-script:backend && npm run gen-script:pc && npm run gen-script:mobile && npm run gen-script:med-pro && ts-node ./packages/cli/src/bin.ts compiler-typedoc && npx typedoc --cleanOutputDir --options internal/typedoc-config/typedoc.json",
    "gen:edhrperm": "node ./helper/gen-edhr-perm.js",
    "gen-script:backend": "ts-node ./packages/cli/src/bin.ts compiler -g './packages/runtime/src/interface/backend-script/**/*.ts' -o ./public/api-types/服务端文档.d.ts",
    "gen-script:med-pro": "ts-node ./packages/cli/src/bin.ts compiler -g './src/projects/page-designer/src/interface/_kit/med-pro/**/*.ts' -o ./public/api-types/MedPro文档.d.ts",
    "gen-script:mobile": "ts-node ./packages/cli/src/bin.ts compiler -g './packages/runtime/src/interface/script/**/*.ts','./packages/runtime/src/interface/backend-script/model-service/**/*.ts','./packages/runtime/src/interface/backend-script/i-query-params.ts','./packages/runtime/src/interface/backend-script/i-sort-item.ts','./src/projects/page-designer/src/interface/mobile/**/*.ts' -o ./public/api-types/移动端文档.d.ts --exclude 'packages/runtime/src/interface/script/context/i-pc-script-context.ts','packages/runtime/src/interface/script/context/pc-ctx.ts'",
    "gen-script:pc": "ts-node ./packages/cli/src/bin.ts compiler -g './packages/runtime/src/interface/script/**/*.ts','./packages/runtime/src/interface/backend-script/model-service/**/*.ts','./packages/runtime/src/interface/backend-script/i-query-params.ts','./packages/runtime/src/interface/backend-script/i-sort-item.ts','./src/projects/page-designer/src/interface/web/**/*.ts' -o ./public/api-types/网页端文档.d.ts --exclude 'packages/runtime/src/interface/script/context/i-mobile-script-context.ts','packages/runtime/src/interface/script/context/mobile-ctx.ts'",
    "genapis": "node ./helper/api.js",
    "genapis:mobile": "pnpm -r --filter=@gct/mobile run apis",
    "geniconfont": "node ./helper/iconfont.mjs",
    "initi18n": "node ./helper/init-i18n.js",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "turbo run stub",
    "lint": "turbo run lint",
    "lint:eslint": "eslint --cache --max-warnings 0  \"{src,mock}/**/*.{vue,ts,tsx}\" --fix",
    "lint:prettier": "prettier --write .",
    "lint:stylelint": "stylelint \"**/*.{vue,css,less.scss}\" --fix --cache --cache-location node_modules/.cache/stylelint/",
    "prepare": "node -e \"console.log('skip nested vendor git hooks')\"",
    "preview": "vite preview",
    "reinstall": "rimraf pnpm-lock.yaml && rimraf package.lock.json && rimraf node_modules && npm run bootstrap",
    "remove:svgfill": "node ./helper/remove-svg-fill.js",
    "scan-dep": "ts-node ./packages/cli/src/bin.ts scan-dep --glob './src/projects/page-designer/src/_kit'",
    "serve": "npm run dev",
    "test:gzip": "npx http-server dist --cors --gzip -c-1",
    "type:check": "vue-tsc --noEmit --skipLibCheck"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "{!(package)*.json,*.code-snippets,.!(browserslist)*rc}": [
      "prettier --write--parser json"
    ],
    "package.json": [
      "prettier --write"
    ],
    "*.vue": [
      "prettier --write",
      "eslint --fix",
      "stylelint --fix"
    ],
    "*.{scss,less,styl,html}": [
      "prettier --write",
      "stylelint --fix"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "resolutions": {
    "esbuild": "0.23.0"
  },
