{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "global.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "../../src/**/*.vue",
    "../../src/**/*",
    "start/**/*",
    "native/**/*"
  ],
  "exclude": ["src/**/__tests__/*", "node_modules"],
  "compilerOptions": {
    "composite": true,
    "rootDir": "../../",
    "baseUrl": ".",
    "types": ["./node_modules/@gct-paas/core/es/types/index.d.ts"],
    "paths": {
      "@native/*": ["./native/*"],
      "@/*": ["../../src/*"],
      "#/*": ["../../types/*"],
      "@start/*": ["./start/*"],
      "@mobile/*": ["./src/*"],
      "/@/apis/*": ["./src/apis/*"],
      "/@page-designer/*": ["../../src/projects/page-designer/src/*"],
      "/@web-render/*": ["../../src/projects/web-render/src/*"]
    }
  }
}
