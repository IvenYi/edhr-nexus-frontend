{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@vben/ts-config/vue-app.json",
  "include": [
    "global.d.ts",
    "types/**/*.d.ts",
    "src/**/*",
    "src/**/*.vue",
  ],
  "compilerOptions": {
    "types": ["@gct-paas/core/es/types"],
    "paths": {
      "/@/*": ["../../src/*"],
      "@mobile/*": ["../mobile/src/*"],
      "/@page-designer/*": ["../../src/projects/page-designer/src/*"],
    }
  }
}
