%% eDHR 生产执行快照、事务上下文与追溯关系（推荐目标模型）
%% 实线为已实现主数据关系；虚线为生产模块实现后建立的运行期关系。
flowchart LR
    classDef master fill:#e8f0fe,stroke:#1967d2,color:#12335e,stroke-width:1px;
    classDef runtime fill:#e6f4ea,stroke:#2e7d32,color:#173f24,stroke-width:1px;
    classDef evidence fill:#fff4e5,stroke:#b06000,color:#5c3300,stroke-width:1px;
    classDef planned fill:#f1f3f4,stroke:#6b7280,color:#374151,stroke-dasharray: 5 4;

    A["产品 / 产品簇"] --> B["产品制程版本"]
    B --> C["工艺路线版本"]
    B --> D["DHR 模板版本"]
    C --> E["路线工序节点"]
    D --> F["DHR 目录项"]
    F --> G["表单模板版本"]
    E --> H["工序表单绑定<br/>仅可引用该 DHR 目录表单"]
    E --> I["工序文档绑定<br/>可配置 PDF 页码"]

    B -. "工单 / 批次显式选择" .-> J["生产批次"]
    J -. "冻结" .-> K["执行快照"]
    K -. "展开" .-> L["工序实例与当前工序"]
    K -. "创建" .-> M["DHR 实例"]
    L -. "创建 / 关联" .-> N["工序表单实例"]
    N -. "最终快照投影" .-> O["主线事件、关系边、业务统计"]
    N -. "完成后成为候选证据" .-> M
    L -. "携带主体、工序、快照、触发事件" .-> P["事务上下文"]
    P -. "P1 创建" .-> Q["事务实例与节点状态"]
    R["事务定义 / 适用规则"] -. "P1 选择定义" .-> Q
    Q -. "表单节点" .-> S["事务表单实例"]
    S -. "最终快照投影" .-> O
    Q -. "创建 / 完成 / 关闭" .-> O
    Q -. "未关闭状态" .-> M
    M -. "汇总审核后" .-> T["冻结的 DHR 汇总版本"]
    T -. "放行后" .-> U["归档记录与追溯查询"]

    class A,B,C,D,E,F,G,H,I master;
    class J,K,L,M,N,P runtime;
    class O,T,U evidence;
    class J,K,L,M,N,O,P,Q,R,S,T,U planned;
