%% Codex 协作交付与 eDHR 本体规则作业运行架构
%% Codex 属于产品外部的开发和交付工具；本体、规则、作业编排和动作处理器属于产品运行能力。
flowchart TB
    classDef actor fill:#fff7e6,stroke:#ad6800,color:#5c3b00,stroke-width:1px;
    classDef codex fill:#e6f4ff,stroke:#1677ff,color:#102a43,stroke-width:1px;
    classDef asset fill:#f6ffed,stroke:#389e0d,color:#173d0b,stroke-width:1px;
    classDef release fill:#fffbe6,stroke:#d4b106,color:#4f4500,stroke-width:1px;
    classDef runtime fill:#f0f5ff,stroke:#2f54eb,color:#182366,stroke-width:1px;
    classDef action fill:#fff1f0,stroke:#cf1322,color:#5c1420,stroke-width:1px;
    classDef domain fill:#f9f0ff,stroke:#722ed1,color:#35145c,stroke-width:1px;
    classDef evidence fill:#f5f5f5,stroke:#595959,color:#262626,stroke-width:1px;
    classDef boundary fill:#ffffff,stroke:#8c8c8c,color:#434343,stroke-dasharray: 5 4;

    subgraph DELIVERY[Codex 协作开发与交付平面（产品外部）]
        direction LR
        U["业务需求与产品决策<br/>团队沟通确认"]:::actor
        C["Codex 主智能体<br/>理解需求、生成决策包、开发和基础测试"]:::codex

        subgraph ASSETS[仓库化协作资产]
            direction TB
            K["AGENTS.md + 角色契约<br/>统一工作流程与分工"]:::asset
            D["decisionPackage + 知识基线<br/>概念、关系、规则、证据"]:::asset
            I["业务代码、数据库、作业定义<br/>配置、插件和测试候选"]:::asset
            S["本体子智能体 + 质量子智能体<br/>知识沉淀、独立验证"]:::asset
        end

        V["验证与人工确认<br/>结构校验、测试、审计和交付审查"]:::release
        PKG["版本化交付资产<br/>Git 提交、迁移、规则、作业定义和插件"]:::release

        U --> C
        C --> K
        C --> D
        C --> I
        K --> S
        D --> S
        I --> V
        S --> V
        V --> PKG
    end

    BOUNDARY["产品发布边界<br/>只加载已确认、已验证和已发布的版本化资产"]:::boundary
    PKG --> BOUNDARY

    subgraph PRODUCT[ eDHR 产品内受控配置与运行平面 ]
        direction TB
        CONFIG["产品内受控配置<br/>RDO、规则、作业定义与可视化编排"]:::runtime

        subgraph EXECUTION[确定性生产运行]
            direction LR
            E["统一业务事件入口<br/>主体、工序、来源、幂等键"]:::runtime
            CTX["执行上下文与快照<br/>产品、制程、规则、作业版本"]:::runtime
            RE["业务规则运行引擎<br/>allow / block / select / trigger"]:::runtime
            TO["作业编排运行时<br/>实例、节点状态、等待、分支"]:::runtime
            AR["动作处理器注册表<br/>契约、权限、幂等、异常语义"]:::action

            subgraph SERVICES[确定性领域服务]
                direction TB
                S1["生产执行<br/>工单、批次、SN、工序"]:::domain
                S2["表单与人工任务"]:::domain
                S3["DHR 与追溯投影"]:::domain
                S4["项目插件与外部连接器"]:::domain
            end

            AUDIT["证据与运行治理<br/>作业主线、审计、节点日志、指标"]:::evidence

            E --> CTX --> RE
            RE -->|"触发已发布作业"| TO
            RE -->|"直接允许或阻断"| S1
            TO --> AR
            AR --> S1
            AR --> S2
            AR --> S3
            AR --> S4
            E --> AUDIT
            RE --> AUDIT
            TO --> AUDIT
            AR --> AUDIT
            SERVICES --> AUDIT
        end

        CONFIG --> CTX
        CONFIG --> TO
    end

    BOUNDARY --> CONFIG
    BOUNDARY -. "加载已发布本体、规则、作业和插件" .-> CTX

    NOAI["Codex / 生成式 AI 不属于生产运行时<br/>不直接决定生产结果或写入受控记录"]:::boundary
    C -. "外部开发和交付工具" .-> NOAI
    NOAI -. "由发布边界隔离" .-> BOUNDARY
