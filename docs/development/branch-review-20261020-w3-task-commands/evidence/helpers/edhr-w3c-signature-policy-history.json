  "conclusions": [
    {
      "id": "policy.button-signature-scope",
      "classification": "confirmed",
      "conclusion": "DEC0028/0074 require actual signer authentication for configured ordinary production form button events, before the action. Cross-account signer must have current business rights; exact username admin only uses login-password exception. This is not evidence that every generic workflow task always requires a signature.",
      "references": [
        "policy-source-04",
        "policy-source-06",
        "policy-source-15"
      ]
    },
    {
      "id": "policy.field-signature-distinct",
      "classification": "confirmed",
      "conclusion": "SIGN_FIELD remains current-session-user personal electronic-signature password, valid certification and certified image. Button cross-account/admin exception does not extend to it; per-copy content changes invalidate current signatures while preserving original evidence. Existing production execution/profile/DHR authentic-signature protections must remain.",
      "references": [
        "policy-source-05",
        "policy-source-06",
        "policy-source-14",
        "policy-source-21"
      ]
    },
    {
      "id": "policy.record-control-stage1-signature-reference",
      "classification": "confirmed-boundary",
      "conclusion": "DEC0042 stage1 freezes applicant signatureId/nonempty reference and rejects idempotency conflicts; authentic applicant signature verification is owned by the future record-control application confirmation transaction. Approval-button signature runtime and results are not implemented merely because DTO/configuration exists. DEC0040 is historical; DEC0041/42 govern current scope.",
      "references": [
        "policy-source-07",
        "policy-source-08",
        "policy-source-09",
        "policy-source-13",
        "policy-source-19",
        "policy-source-20"
      ]
    },
    {
      "id": "policy.record-control-required-signature-validation",
      "classification": "confirmed-design-not-runtime-acceptance",
      "conclusion": "Integration contract lines195-201/452-456 explicitly requires configured signatures to be checked for current actor/action/business and actor from authentication; this is record-control integration semantics, not universal generic signature mandate. Root should check whether current callable runtime falsely claims/consumes such signed decisions, not silently invent a new generic auth mode.",
      "references": [
        "policy-source-18",
        "policy-source-09"
      ]
    },
    {
      "id": "policy.managerial-reassignment-signature-open",
      "classification": "unresolved",
      "conclusion": "Whether managerial reassignment needs extra signature remains an explicit open question. Permission, valid target, reason and immutable audit are already specified; cannot silently require or silently omit an electronic-signature blocker by interpreting optional signatureId as a decided policy.",
      "references": [
        "policy-source-11",
        "policy-source-18",
        "policy-source-19"
      ]
    },
    {
      "id": "policy.raw-runtime-crud-and-termination",
      "classification": "confirmed-design-boundary-source-lead",
      "conclusion": "Integration contract195-201 forbids client generic CRUD modification/deletion of runtime logs/tasks/instances. Original P0 design314/420/422/426 forbids record-control/form-process termination, skipping/forcing/direct admin approval; reassign changes current responsibility only. This is a narrow existing rule worth checking against actual callable commands. It does not prove all unrelated generic workflow business types forbid termination. No runtime verification by this helper.",
      "references": [
        "policy-source-17",
        "policy-source-18"
      ]
    },
    {
      "id": "policy.unknown-signature-target-types",
      "classification": "evidence-gap",
      "conclusion": "Reviewed authorities do not define an exhaustive permitted targetType list for all generic signatures or a universal auth protocol for every generic task. Existing three concrete authentic producer types cannot by themselves justify a new blanket whitelist/business rule. Source/consumer tracing remains required before calling unknown-type CRUD a business bypass.",
      "references": [
        "policy-source-04",
        "policy-source-05",
        "policy-source-06",
        "policy-source-24",
        "policy-source-25"
      ]
    }
  ],
  "historicalDedup": [
    {
      "id": "AUD-H015",
      "conclusion": "KNOWN-APPROVAL-TENANT-001 / configured-subject tenant0 mismatch; affected ExecutionAccess; fix4601eb4907b146375ed14f6bcb568886457b247c; known-fixed-before-audit. Not an old universal generic-signature validation issue.",
      "references": [
        "policy-source-22"
      ]
    },
    {
      "id": "DEC0074-resolved-discrepancies",
      "conclusion": "Admin equalsIgnoreCase bug and prior button verification-pending are resolved historical slices, with scope-boundary evidence in current DEC0074. Preserve exact admin matching and real signer rights; do not reopen unchanged historical issue or claim old tests were run now.",
      "references": [
        "policy-source-06",
        "policy-source-15"
      ]
    },
    {
      "id": "execution-signature-crud-protection",
