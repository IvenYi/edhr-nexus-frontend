    {
      "id": "DEC-0077-20",
      "found": true,
      "recordType": "decisionStatement",
      "sourceLocator": "/decisions/0/decisionStatements/19",
      "record": {
        "id": "DEC-0077-20",
        "statement": "MVP纳入客户维护可复用追溯项目录、普通字段或子表列关联追溯项、表单及DHR反向查询按追溯项提供条件并回查有权限来源表单与命中位置的路径；名称不同的来源字段可以关联同一追溯项。客户管理员定义追溯项，制表人配置字段来源，查询人使用条件；此职责划分不规定每份表单必须由三人依次操作。当前支持文本、数字和日期，数字精确值查询、日期起止范围查询及预置清单按DEC-0077-40；自定义项的引用字段兼容延期，不据此撤销既有预置项合法引用能力。追溯项是内容反向查询配置，不用于定义正向真实关联属性或业务报表固定条件，不等于客户编辑研发本体、定义任意统计口径或据文本建立正式实体关系。保存后过程可查及表单/DHR各自组合范围按现行已确认规则；自定义项CRUD、先解除表单配置再删除及历史填报内容保留按DEC-0077-41，不再将这一范围列为待定。更多类型和操作符、其余目录生命周期、复杂OR和历史处理仍须在对应实现前明确。",
        "status": "specified",
        "visibility": "internal"
      },
      "sourcePath": "docs/knowledge/decisions/DEC-0077-form-traceability-projection-ownership.yaml",
