    {
      "id": "DEC-0077-33",
      "found": true,
      "recordType": "decisionStatement",
      "sourceLocator": "/decisions/0/decisionStatements/32",
      "record": {
        "id": "DEC-0077-33",
        "statement": "已成功保存或暂存的最新表单内容即可在授权追溯查询中查到，包含草稿、填报中、审批中及已完成记录，结果显示来源记录状态；未保存输入不参与查询。正式业务统计仍等待最终完成及其投影成功，不把过程查询命中当成正式结果、DHR归属或业务关系，来源授权与真实归属继续适用。本条在保存生效时点、已保存过程内容及可查状态范围内supersedes DEC-0077-17/20/29的独立索引尚未定状态；失效历史与A12视图仍另定，不因本条开放受控修订或作废。2026-10-10已按保存事务维护独立内容索引，并保存过程阶段；2026-10-14正向进一步不依赖索引绑定。检索存储是工程实现而非客户另建业务，原只查完成SUCCEEDED批次属于修正前差距，不再作为当前范围；未引入异步延迟政策。",
        "status": "specified",
        "visibility": "internal"
      },
      "sourcePath": "docs/knowledge/decisions/DEC-0077-form-traceability-projection-ownership.yaml",
