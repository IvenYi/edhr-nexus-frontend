      "id": "rule.workflow.task-creation-freezes-candidate-resolution",
      "sourcePath": "docs/knowledge/rules/identity.yaml",
      "sourceLocator": "/rules/3",
      "line": 62,
      "fixedCommit": "84c5b6d6af15f4f9d684c99e8eb8d110ae039954",
      "blob": "63b5a2d33367107adabbd2f96f19665311e0a0ee",
      "sourceSha256": "36ecd3de8f1ffacd8178aeb1c5e1f3f62771b846fb711b91a6c38ebe0575694b",
      "recordSha256": "9d41c92e4b904493f3c8c6cf00434aab1ef987c6452f11abf990fc3a19d869b9",
      "status": "implemented",
      "visibility": "internal",
      "currentText": {
        "name": "工作流任务创建冻结候选解析快照",
        "explanation": "审批节点到达时使用主体解析结果创建一个逻辑工作流任务，并在候选快照中记录去重后的候选用户，同时保存解析结果及主体命中来源快照。任务创建后不因组织或角色关系变化重算既有候选集合。",
        "condition": {
          "all": [
            {
              "fact": "subject.resolution.completed",
              "operator": "equals",
              "value": true
            }
          ]
        },
        "result": {
          "type": "create-logical-workflow-task",
          "logicalTaskCount": 1,
          "candidateSnapshotUserCount": "resolved-user-count",
          "persistResolutionSnapshot": true,
          "persistMatchProvenance": true,
          "candidateMembershipFrozenAfterCreate": true
        }
      },
      "proposedDisposition": "retained",
      "qualification": "结构化candidateMembershipFrozenAfterCreate及解析来源保存仍成立；可补明确当前委托状态单独记录。",
      "semanticAcceptanceClaim": false
    },
    {
